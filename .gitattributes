# 默认：文本文件自动识别，仓库内统一 LF，检出时按平台转换
* text=auto eol=lf

# 源码
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.mermaid text eol=lf

# Windows 脚本需 CRLF，否则 cmd/PowerShell 解析异常
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# NSIS 安装器脚本
*.nsh     text eol=crlf

# 二进制文件：不做行尾转换，Git 按二进制处理
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.ttf     binary
*.woff    binary
*.woff2   binary
*.otf     binary
*.exe     binary
*.dll     binary
*.asar    binary
*.zip     binary
*.7z      binary

# 二进制文件的 diff 展示
*.png     diff=image
*.jpg     diff=image
*.ico     diff=image

# 构建产物不参与语言统计
dist/**       linguist-generated=true
package-lock.json linguist-generated=true

# 文档
*.md      linguist-documentation=false
