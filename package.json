{
  "name": "quillpad",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "description": "QuillPad — 面向 Notepad++ 用户的现代文本/代码编辑器",
  "author": "Frank (Frank-TCA)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Frank-TCA/quillpad-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/Frank-TCA/quillpad-desktop/issues"
  },
  "homepage": "https://github.com/Frank-TCA/quillpad-desktop#readme",
  "keywords": [
    "editor",
    "notepad-alternative",
    "markdown",
    "codemirror",
    "electron",
    "wysiwyg",
    "text-editor"
  ],
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "app": "vite --port 4173 --open",
    "desktop": "electron .",
    "clean:dist": "node build/clean-dist.mjs",
    "build:uninstaller": "node build/build-uninstaller.mjs",
    "build:exe": "node build/clean-dist.mjs && vite build && electron-builder --win && node build/build-uninstaller.mjs",
    "build:installer": "node build/clean-dist.mjs && vite build && electron-builder --win nsis && node build/build-uninstaller.mjs",
    "build:portable": "node build/clean-dist.mjs && vite build && electron-builder --win portable",
    "test:desktop": "node scripts/desktop-check.mjs",
    "test:v2:unit": "node scripts/v2-unit.mjs",
    "test:v2": "node scripts/v2-check.mjs",
    "test:e2e:full": "node scripts/qa.mjs",
    "test:visual": "node scripts/visual-audit.mjs",
    "test:pdf": "node scripts/pdf-check.mjs",
    "test:icon": "node scripts/icon-check.mjs",
    "notices": "node scripts/notices.mjs",
    "license:check": "node scripts/notices.mjs --check",
    "icon:build": "node build/render-icon.mjs && node build/pack-ico.mjs",
    "test:newfile": "node scripts/newfile-check.mjs",
    "test:fold": "node scripts/fold-check.mjs",
    "test:uninstall": "node scripts/uninstall-check.mjs",
    "test:i18n": "node scripts/i18n-audit.mjs --strict",
    "test:plugins:ui": "node scripts/plugin-manager-check.mjs",
    "test:installed": "node scripts/smoke-installed.mjs",
    "test:plugins": "node scripts/data-check.mjs && node scripts/plugin-pack-check.mjs && node scripts/plugin-keys-check.mjs",
    "plugins:pack": "node scripts/build-community-zips.mjs",
    "readme:shots": "node scripts/readme-shots.mjs",
    "test": "node scripts/menu-fix-check.mjs && node scripts/smoke.mjs && node scripts/p1-check.mjs && node scripts/find-panel-check.mjs && node scripts/statusbar-check.mjs && node scripts/edit-ops-check.mjs && node scripts/fold-check.mjs && node scripts/v2-unit.mjs && node scripts/newfile-check.mjs && node scripts/data-check.mjs && node scripts/plugin-pack-check.mjs && node scripts/plugin-keys-check.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "katex": "^0.16.47",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "rcedit": "^5.0.2",
    "vite": "^6.4.5"
  }
}
