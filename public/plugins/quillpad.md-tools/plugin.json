{
  "id": "quillpad.md-tools",
  "name": "Markdown 增强包",
  "description": "表格对齐规范化、TOC 生成、脚注插入、中英字数与阅读时长统计，共 4 条命令。",
  "author": "QuillPad 官方",
  "version": "1.0.0",
  "license": "MIT",
  "engines": { "quillpad": ">=1.0.0" },
  "main": "main.js",
  "permissions": ["editor:read", "editor:write"],
  "contributes": {
    "commands": [
      { "id": "normalize-table", "title": "规范表格对齐", "key": "Mod-Alt-g" },
      { "id": "generate-toc", "title": "生成目录", "key": "Mod-Alt-o" },
      { "id": "insert-footnote", "title": "插入脚注", "key": "Mod-Alt-n" },
      { "id": "word-count", "title": "字数与阅读时长", "key": "Mod-Alt-w" }
    ]
  }
}
